--- !u!114 &934113900
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 934113899}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2311abdf57e6421fae88ca8f6dcb35a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  instructions: "FIRE EXTINGUISHER SETUP INSTRUCTIONS:\n\n1. PARTICLE SYSTEM COLLISION
    SETUP:\n   - Select the FireEX_PS prefab in your scene\n   - In the Particle
    System component, expand the 'Collision' section\n   - Check 'Enabled' to turn
    on collision\n   - Set Type to 'World'\n   - Set Mode to 'Collision'  \n   -
    Check 'Send Collision Messages' (IMPORTANT!)\n   - Set Collision Quality to 'High'
    for better detection\n   - Set Max Collision Shapes to 256\n   - Check 'Enable
    Dynamic Colliders' if needed\n\n2. FIRE OBJECT SETUP:\n   - Add FireExtinguisher.cs
    script to ALL fire objects:\n     * Flammable objects (with FlammableObject.cs)\n    
    * Chemical containers (with ChemicalContainer.cs)  \n     * Fire zones (with
    FireZone.cs)\n   \n3. SPRAY OBJECT TAG:\n   - Set the spray particle system's
    GameObject tag to 'Smoke'\n   - Or ensure the GameObject name contains 'FireEX_PS'\n\n4.
    TESTING:\n   - Play the scene\n   - Use the VR controller trigger to spray\n  
    - Spray should gradually reduce fire size\n   - Fire should extinguish when intensity
    drops to 0"
  autoConfigureSprayParticles: 1
  autoAddFireExtinguisherScripts: 1
  sprayParticleSystem: {fileID: 7572671818341624242}
  fireObjects: []
